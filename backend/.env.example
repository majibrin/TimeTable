# Copy this file to backend/.env for local development
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Leave empty for SQLite development.
# In production, Railway/Postgres will provide a full PostgreSQL URL.
DATABASE_URL=

# Example production PostgreSQL value:
# DATABASE_URL=postgresql://postgres:postgres@db.railway.app:5432/railway
